<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Play</title>
  <style>
    body { font-family: system-ui; background:#000; color:#fff; display:flex; align-items:center; justify-content:center; height:100vh; margin:0; }
    .card { width:min(520px, 92vw); text-align:center; }
    .user { font-size:28px; letter-spacing:1px; margin-bottom:12px; opacity:0.9; }
    .btn { user-select:none; -webkit-user-select:none; touch-action:none;
           background:#fff; color:#000; border-radius:18px; padding:22px; font-size:22px; font-weight:700; }
    .hint { margin-top:10px; opacity:0.7; font-size:14px; }
    .bar { height:10px; background:#222; border-radius:999px; overflow:hidden; margin-top:18px; }
    .fill { height:100%; width:0%; background:#fff; transition:width 0.05s linear; }
    .msg { margin-top:14px; min-height:24px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="user" id="user">Loading…</div>
    <div class="btn" id="hold">HOLD TO LOCK ENTRY</div>
    <div class="bar"><div class="fill" id="fill"></div></div>
    <div class="msg" id="msg"></div>
    <div class="hint">Don’t release until complete.</div>
  </div>

<script>
const API_URL = "PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE";
const HOLD_MS = 7000;

const qs = new URLSearchParams(location.search);
const token = qs.get("t");

const elUser = document.getElementById("user");
const elHold = document.getElementById("hold");
const elFill = document.getElementById("fill");
const elMsg  = document.getElementById("msg");

let holding = false;
let start = 0;
let raf = null;

async function api(body){
  const res = await fetch(API_URL, {
    method: "POST",
    headers: { "Content-Type":"text/plain;charset=utf-8" }, // Apps Script friendly
    body: JSON.stringify(body)
  });
  return res.json();
}

async function init(){
  if(!token){
    elUser.textContent = "INVALID BRACELET";
    elMsg.textContent = "Missing token.";
    elHold.style.opacity = 0.4;
    return;
  }
  const data = await api({ action:"lookup", token });
  if(!data.ok){
    elUser.textContent = "INVALID BRACELET";
    elMsg.textContent = data.error || "Error";
    elHold.style.opacity = 0.4;
    return;
  }
  elUser.textContent = `USER ${String(data.bracelet.user_number).padStart(4,"0")}`;
  if(!data.entries_open){
    elMsg.textContent = "Entries are closed.";
    elHold.style.opacity = 0.4;
  }
}
init();

function setMsg(t){ elMsg.textContent = t; }

function resetHold(){
  holding = false;
  start = 0;
  elFill.style.width = "0%";
  if(raf) cancelAnimationFrame(raf);
  raf = null;
}

async function complete(){
  setMsg("Locking…");
  const data = await api({ action:"claim", token });
  if(data.ok && (data.claimed || data.already)){
    setMsg("ENTRY LOCKED ✅");
    elHold.textContent = "LOCKED";
    elHold.style.opacity = 0.6;
  } else {
    setMsg(data.error || "Failed. Try again.");
    resetHold();
  }
}

function tick(){
  if(!holding) return;
  const elapsed = Date.now() - start;
  const pct = Math.min(100, (elapsed / HOLD_MS) * 100);
  elFill.style.width = pct + "%";
  if(elapsed >= HOLD_MS){
    holding = false;
    complete();
    return;
  }
  raf = requestAnimationFrame(tick);
}

function onDown(e){
  if(elHold.style.opacity < 0.5) return; // disabled
  e.preventDefault();
  if(holding) return;
  holding = true;
  start = Date.now();
  setMsg("");
  elHold.textContent = "HOLDING…";
  tick();
}

function onUp(e){
  if(!holding) return;
  e.preventDefault();
  setMsg("RELEASED TOO EARLY — TRY AGAIN");
  elHold.textContent = "HOLD TO LOCK ENTRY";
  resetHold();
}

elHold.addEventListener("pointerdown", onDown);
window.addEventListener("pointerup", onUp);
window.addEventListener("pointercancel", onUp);
</script>
</body>
</html>
